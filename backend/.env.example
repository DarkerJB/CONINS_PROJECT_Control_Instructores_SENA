# CONINS Backend — Environment Variables
# Copiar a .env y completar valores reales

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL — Laragon)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=conIns

# JWT
JWT_SECRET=change-this-to-a-random-secure-string
JWT_EXPIRES_IN=24h

# Frontend (CORS)
FRONTEND_URL=http://localhost:3000

# Email (Nodemailer — RF-38)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=conins@sena.edu.co
